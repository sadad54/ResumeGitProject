# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://proofhire:proofhire@localhost:5432/proofhire
POSTGRES_USER=proofhire
POSTGRES_PASSWORD=proofhire
POSTGRES_DB=proofhire

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- App auth (self-hosted JWT/OIDC) ---
AUTH_SECRET_KEY=changeme-generate-a-real-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- GitHub OAuth ---
# Redirect URI points at the API's own callback (apps/api/proofhire_api/routers/github.py),
# not the Next.js app — GitHub redirects the browser here directly after authorization.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/github/callback

# --- Token encryption (envelope encryption for GitHubConnection.token_ref) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

# --- LLM providers ---
# OPENAI_API_KEY is also used for embeddings regardless of LLM_DEFAULT_PROVIDER
# (Anthropic and Groq have no first-party embeddings endpoint; see
# provider_factory.get_embedding_provider). Unset = mock embeddings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_DEFAULT_PROVIDER=anthropic

# --- Object storage (S3-compatible) ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=proofhire-dev

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- App ---
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# Exposed to the browser bundle (Next.js NEXT_PUBLIC_ convention) — the web app's
# client-side fetch/SSE calls use this directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Per-task model selection (PRD §25). Any provider's model id — must match
# whichever provider LLM_DEFAULT_PROVIDER selects (e.g. "llama-3.3-70b-versatile"
# for groq, "gpt-4o-mini" for openai, "claude-sonnet-5" for anthropic). Task
# names: evidence_extract, jd_extract, rerank, position, resume_write,
# cover_letter_write, claim_verify. Unset = LLM_MODEL_DEFAULT = claude-sonnet-5.
LLM_MODEL_DEFAULT=
LLM_MODEL_RERANK=
LLM_MODEL_EVIDENCE_EXTRACT=
LLM_EMBEDDING_MODEL=
